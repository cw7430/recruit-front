{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    /* === 파일 구조 === */
    "rootDir": "./src",
    "outDir": "./dist",

    /* === Node 환경 설정 === */
    "module": "CommonJS",
    "lib": ["ES2023"],
    "types": ["node"],
    "esModuleInterop": true,

    /* === 엄격한 타입 옵션 === */
    "noUncheckedIndexedAccess": true,

    /* === 기타 === */
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* === 경로 별칭 === */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
